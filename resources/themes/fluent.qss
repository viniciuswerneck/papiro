/* ========================================================================
   Fluent Design QSS for Papiro — LIGHT THEME
   Generated from fluent.json tokens
   ======================================================================== */

/* ------------------------------------------------------------------------
   BASE WIDGET
   ------------------------------------------------------------------------ */
QWidget {
    font-family: "Segoe UI Variable", "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
    color: #1B1B1B;
    background-color: #FFFFFF;
}

/* ------------------------------------------------------------------------
   MAIN WINDOW
   ------------------------------------------------------------------------ */
MainWindow {
    background-color: #FFFFFF;
    border-radius: 8px;
}

/* ------------------------------------------------------------------------
   TAB WIDGET & TAB BAR (Fluent Style)
   ------------------------------------------------------------------------ */
QTabWidget::pane {
    border: 1px solid #D1D1D1;
    border-radius: 0 0 8px 8px;
    background-color: #FFFFFF;
    margin-top: -1px;
}

QTabBar {
    qproperty-drawBase: 0;
    background: transparent;
}

QTabBar::tab {
    min-width: 120px;
    height: 36px;
    padding: 0 16px;
    margin: 4px 4px 0 4px;
    border-radius: 6px 6px 0 0;
    background-color: transparent;
    color: #1B1B1B;
    font-weight: 500;
    font-size: 14px;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    border-bottom: 2px solid #0078D4;
    color: #0078D4;
}

QTabBar::tab:hover:!selected {
    background-color: #F3F3F3;
}

QTabBar::tab:!selected {
    margin-top: 4px;
}

QTabBar::close-button {
    /* Using standard close button from style */
    width: 16px;
    height: 16px;
    border-radius: 4px;
    margin: 4px;
    background: transparent;
}

QTabBar::close-button:hover {
    background-color: #E8E8E8;
}

QTabBar::close-button:pressed {
    background-color: #DCDCDC;
}

/* Tab bar scroll buttons */
QTabBar::scroller {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    margin: 4px 2px;
    background: transparent;
}

QTabBar::scroller:hover {
    background-color: #E8E8E8;
}

/* ------------------------------------------------------------------------
   MENU BAR & MENUS
   ------------------------------------------------------------------------ */
QMenuBar {
    /* Do not set a fixed `height` here: it makes Qt lay the items out taller
       than the bar (items get the height of the bar + padding), so the labels
       are painted outside the menu bar's clip rect and the menu looks empty. */
    padding: 0 8px;
    background-color: transparent;
    color: #1B1B1B;
    font-weight: 500;
}

QMenuBar::item {
    padding: 4px 12px;
    border-radius: 4px;
    margin: 2px 2px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #E8E8E8;
}

QMenuBar::item:pressed {
    background-color: #DCDCDC;
}

QMenu {
    border: 1px solid #D1D1D1;
    border-radius: 8px;
    padding: 6px;
    background-color: #FFFFFF;
    margin: 4px;
    min-width: 200px;
    color: #1B1B1B;
}

QMenu::item {
    padding: 8px 16px;
    border-radius: 4px;
    margin: 2px 4px;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: #E8E8E8;
    color: #1B1B1B;
}

QMenu::item:disabled {
    color: #9D9D9D;
}

QMenu::separator {
    height: 1px;
    background-color: #D1D1D1;
    margin: 4px 8px;
}

QMenu::icon {
    width: 18px;
    height: 18px;
    margin-left: 4px;
}

QMenu::right-arrow {
    /* Using standard arrow from style */
    width: 12px;
    height: 12px;
    margin-right: 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}

/* ------------------------------------------------------------------------
   TOOL BAR & TOOL BUTTONS
   ------------------------------------------------------------------------ */
QToolBar {
    height: 40px;
    spacing: 4px;
    padding: 0 8px;
    background-color: transparent;
    border: none;
}

QToolButton {
    padding: 6px 12px;
    border-radius: 6px;
    margin: 2px;
    background-color: transparent;
    border: none;
    color: #1B1B1B;
    font-size: 14px;
    font-weight: 500;
}

QToolButton:hover {
    background-color: #E8E8E8;
}

QToolButton:pressed {
    background-color: #DCDCDC;
}

QToolButton:disabled {
    color: #9D9D9D;
}

QToolButton[popupMode="1"] {
    padding-right: 24px;
}

QToolButton::menu-indicator {
    /* Using standard arrow from style */
    width: 12px;
    height: 12px;
    subcontrol-position: right center;
    subcontrol-origin: padding;
    right: 8px;
}

/* ToolBar separator */
QToolBar::separator {
    width: 1px;
    background-color: #D1D1D1;
    margin: 6px 4px;
}

/* ------------------------------------------------------------------------
   STATUS BAR
   ------------------------------------------------------------------------ */
QStatusBar {
    height: 28px;
    padding: 0 12px;
    background-color: #F3F3F3;
    border-top: 1px solid #D1D1D1;
    color: #616161;
    font-size: 13px;
}

QStatusBar::item {
    border: none;
    padding: 0 4px;
}

/* ------------------------------------------------------------------------
   DOCK WIDGETS
   ------------------------------------------------------------------------ */
QDockWidget {
    font-weight: 600;
    font-size: 13px;
    color: #616161;
    background-color: transparent;
}

QDockWidget::title {
    padding: 6px 12px;
    background-color: transparent;
    border-bottom: 1px solid #D1D1D1;
}

QDockWidget::close-button,
QDockWidget::float-button {
    border-radius: 4px;
    padding: 4px;
    margin: 2px;
    background: transparent;
    /* Using standard icon from style */
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #E8E8E8;
}

QDockWidget::close-button:pressed,
QDockWidget::float-button:pressed {
    background-color: #DCDCDC;
}

/* ------------------------------------------------------------------------
   BUTTONS
   ------------------------------------------------------------------------ */
QPushButton {
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #D1D1D1;
    background-color: #FFFFFF;
    color: #1B1B1B;
    font-weight: 500;
    font-size: 14px;
    min-height: 20px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #F3F3F3;
    border-color: #A0A0A0;
}

QPushButton:pressed {
    background-color: #E8E8E8;
    border-color: #8C8C8C;
}

QPushButton:disabled {
    color: #9D9D9D;
    border-color: #E8E8E8;
    background-color: #F3F3F3;
}

QPushButton:focus {
    border: 2px solid #0078D4;
    padding: 7px 15px; /* compensate for border width */
}

/* Primary Button */
QPushButton[primary="true"] {
    background-color: #0078D4;
    border-color: #0078D4;
    color: #FFFFFF;
}

QPushButton[primary="true"]:hover {
    background-color: #106EBE;
    border-color: #106EBE;
}

QPushButton[primary="true"]:pressed {
    background-color: #005A9E;
    border-color: #005A9E;
}

QPushButton[primary="true"]:disabled {
    background-color: #A6A6A6;
    border-color: #A6A6A6;
    color: #FFFFFF;
}

/* ------------------------------------------------------------------------
   COMBO BOX
   ------------------------------------------------------------------------ */
QComboBox {
    /* Use a regular list popup instead of the menu-style one. With the menu
       popup Qt sizes the container from a row height that ignores the
       ::item padding below, so the viewport ends up shorter than the rows
       and the list opens showing a single item plus scroll arrows. */
    combobox-popup: 0;
    padding: 6px 12px;
    padding-right: 32px;
    border: 1px solid #D1D1D1;
    border-radius: 6px;
    background-color: #FFFFFF;
    color: #1B1B1B;
    font-size: 14px;
    min-height: 20px;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #0078D4;
}

QComboBox:focus {
    border-color: #0078D4;
    border-width: 2px;
    padding: 5px 11px 5px 11px;
}

QComboBox:disabled {
    color: #9D9D9D;
    border-color: #E8E8E8;
    background-color: #F3F3F3;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #D1D1D1;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: transparent;
}

QComboBox::drop-down:hover {
    background-color: #F3F3F3;
}

QComboBox::down-arrow {
    /* Using standard arrow from style */
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    border: 1px solid #D1D1D1;
    border-radius: 6px;
    background-color: #FFFFFF;
    selection-background-color: #DEECF9;
    selection-color: #0078D4;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
    margin: 1px 4px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #DEECF9;
    color: #0078D4;
}

/* ------------------------------------------------------------------------
   SPIN BOX
   ------------------------------------------------------------------------ */
QSpinBox {
    padding: 6px 12px;
    padding-right: 28px;
    border: 1px solid #D1D1D1;
    border-radius: 6px;
    background-color: #FFFFFF;
    color: #1B1B1B;
    font-size: 14px;
    min-height: 20px;
    min-width: 80px;
}

QSpinBox:hover {
    border-color: #0078D4;
}

QSpinBox:focus {
    border-color: #0078D4;
    border-width: 2px;
    padding: 5px 11px 5px 11px;
}

QSpinBox:disabled {
    color: #9D9D9D;
    border-color: #E8E8E8;
    background-color: #F3F3F3;
}

QSpinBox::up-button,
QSpinBox::down-button {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
    border-radius: 0 5px 0 0;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-radius: 0 0 5px 0;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #F3F3F3;
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed {
    background-color: #E8E8E8;
}

QSpinBox::up-arrow {
    /* Using standard arrow from style */
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow {
    /* Using standard arrow from style */
    width: 10px;
    height: 10px;
}

/* ------------------------------------------------------------------------
   LINE EDIT, TEXT EDIT, PLAIN TEXT EDIT
   ------------------------------------------------------------------------ */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    padding: 8px 12px;
    border: 1px solid #D1D1D1;
    border-radius: 6px;
    background-color: #FFFFFF;
    color: #1B1B1B;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
    font-size: 14px;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #A0A0A0;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #0078D4;
    border-width: 2px;
    padding: 7px 11px;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    color: #9D9D9D;
    border-color: #E8E8E8;
    background-color: #F3F3F3;
}

QLineEdit[readOnly="true"],
QTextEdit[readOnly="true"],
QPlainTextEdit[readOnly="true"] {
    background-color: #F3F3F3;
    color: #616161;
}

/* ------------------------------------------------------------------------
   CHECK BOX & RADIO BUTTON
   ------------------------------------------------------------------------ */
QCheckBox,
QRadioButton {
    spacing: 8px;
    color: #1B1B1B;
    font-size: 14px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #D1D1D1;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #0078D4;
}

QCheckBox::indicator:focus,
QRadioButton::indicator:focus {
    border: 2px solid #0078D4;
}

QCheckBox::indicator:checked {
    /* Using standard check from style */
    background-color: #0078D4;
    border-color: #0078D4;
}

QCheckBox::indicator:unchecked:hover {
    background-color: #F3F3F3;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    background-color: #FFFFFF;
    border-color: #0078D4;
    /* Using standard radio checked from style */
}

/* ------------------------------------------------------------------------
   SLIDER
   ------------------------------------------------------------------------ */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #D1D1D1;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -8px 0;
    background-color: #0078D4;
    border-radius: 10px;
    border: none;
}

QSlider::handle:horizontal:hover {
    background-color: #106EBE;
}

QSlider::handle:horizontal:pressed {
    background-color: #005A9E;
}

QSlider::sub-page:horizontal {
    background-color: #0078D4;
    border-radius: 2px;
}

/* ------------------------------------------------------------------------
   SCROLL BARS (Fluent Thin Overlay Style)
   ------------------------------------------------------------------------ */
QScrollBar:vertical {
    width: 8px;
    background-color: transparent;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #C8C8C8;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #A0A0A0;
}

QScrollBar::handle:vertical:pressed {
    background-color: #8C8C8C;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    height: 8px;
    background-color: transparent;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #C8C8C8;
    border-radius: 4px;
    min-width: 30px;
    margin: 2px 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #A0A0A0;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #8C8C8C;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

/* ------------------------------------------------------------------------
   TREE VIEW & LIST VIEW
   ------------------------------------------------------------------------ */
QTreeView,
QListView {
    border: 1px solid #D1D1D1;
    border-radius: 6px;
    background-color: #FFFFFF;
    outline: none;
    show-decoration-selected: 1;
    alternate-background-color: #F7F7F7;
}

QTreeView::item,
QListView::item {
    padding: 6px 12px;
    border-radius: 4px;
    margin: 1px 4px;
    color: #1B1B1B;
}

QTreeView::item:selected,
QListView::item:selected {
    background-color: #DEECF9;
    color: #0078D4;
}

QTreeView::item:hover:!selected,
QListView::item:hover:!selected {
    background-color: #F3F3F3;
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    /* Using standard arrow from style */
    width: 12px;
    height: 12px;
    margin-left: 4px;
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    /* Using standard arrow from style */
    width: 12px;
    height: 12px;
    margin-left: 4px;
}

QHeaderView::section {
    padding: 6px 12px;
    border: none;
    border-bottom: 1px solid #D1D1D1;
    background-color: #F3F3F3;
    color: #616161;
    font-weight: 600;
    font-size: 13px;
}

QHeaderView::section:first {
    border-top-left-radius: 6px;
}

QHeaderView::section:last {
    border-top-right-radius: 6px;
}

/* ------------------------------------------------------------------------
   TABLE VIEW
   ------------------------------------------------------------------------ */
QTableView {
    border: 1px solid #D1D1D1;
    border-radius: 6px;
    background-color: #FFFFFF;
    gridline-color: #E1E1E1;
    outline: none;
    alternate-background-color: #F7F7F7;
}

QTableView::item {
    padding: 6px 12px;
    border: none;
}

QTableView::item:selected {
    background-color: #DEECF9;
    color: #0078D4;
}

/* ------------------------------------------------------------------------
   DIALOGS
   ------------------------------------------------------------------------ */
QDialog {
    border-radius: 12px;
    background-color: #FFFFFF;
}

QDialogButtonBox {
    padding: 12px;
}

QDialogButtonBox QPushButton {
    min-width: 96px;
}

/* ------------------------------------------------------------------------
   GROUP BOX
   ------------------------------------------------------------------------ */
QGroupBox {
    border: 1px solid #D1D1D1;
    border-radius: 8px;
    margin-top: 16px;
    padding-top: 16px;
    font-weight: 600;
    color: #1B1B1B;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    background-color: #FFFFFF;
}

/* ------------------------------------------------------------------------
   LABEL
   ------------------------------------------------------------------------ */
QLabel {
    color: #1B1B1B;
    background-color: transparent;
}

QLabel[secondary="true"] {
    color: #616161;
    font-size: 13px;
}

/* ------------------------------------------------------------------------
   PROGRESS BAR
   ------------------------------------------------------------------------ */
QProgressBar {
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    background-color: #F3F3F3;
    text-align: center;
    color: #1B1B1B;
    font-size: 12px;
    height: 8px;
}

QProgressBar::chunk {
    background-color: #0078D4;
    border-radius: 3px;
}

/* ------------------------------------------------------------------------
   SPLITTER
   ------------------------------------------------------------------------ */
QSplitter::handle {
    background-color: #D1D1D1;
    width: 1px;
    height: 1px;
}

QSplitter::handle:horizontal {
    width: 8px;
    background-color: transparent;
}

QSplitter::handle:vertical {
    height: 8px;
    background-color: transparent;
}

QSplitter::handle:hover {
    background-color: #0078D4;
}

/* ------------------------------------------------------------------------
   TOOLTIP
   ------------------------------------------------------------------------ */
QToolTip {
    border: 1px solid #D1D1D1;
    border-radius: 6px;
    padding: 8px 12px;
    background-color: #252526;
    color: #FFFFFF;
    font-size: 13px;
}

/* ------------------------------------------------------------------------
   MESSAGE BOX
   ------------------------------------------------------------------------ */
QMessageBox {
    background-color: #FFFFFF;
    border-radius: 12px;
}

QMessageBox QLabel {
    color: #1B1B1B;
    min-width: 300px;
}

QMessageBox QPushButton {
    min-width: 96px;
}

/* ------------------------------------------------------------------------
   TEXT BROWSER (Output dock)
   ------------------------------------------------------------------------ */
QTextBrowser {
    border: 1px solid #D1D1D1;
    border-radius: 6px;
    background-color: #FFFFFF;
    color: #1B1B1B;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

/* Links in output */
QTextBrowser a {
    color: #0078D4;
    text-decoration: underline;
}

QTextBrowser a:hover {
    color: #106EBE;
}

/* ------------------------------------------------------------------------
   FOCUS INDICATOR (Global)
   ------------------------------------------------------------------------ */
QWidget:focus {
    outline: none;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QPushButton:focus,
QCheckBox:focus,
QRadioButton:focus,
QTabBar::tab:focus,
QTreeView:focus,
QListView:focus,
QTableView:focus {
    border: 2px solid #0078D4;
}

/* ------------------------------------------------------------------------
   TRANSITIONS (via QPropertyAnimation on palette/stylesheet changes)
   Note: QSS doesn't support transitions natively, but we can use
   QWidget::setAttribute(Qt::WA_StyledBackground) and animate palette
   ------------------------------------------------------------------------ */

/* ========================================================================
   Fluent Design QSS for Papiro — DARK THEME
   ======================================================================== */

/* Use a separate stylesheet or prepend [theme="dark"] to rules.
   For simplicity, here's the dark variant as override rules. */

[theme="dark"] QWidget,
[theme="dark"] MainWindow,
[theme="dark"] QDialog,
[theme="dark"] QMenu,
[theme="dark"] QDockWidget,
[theme="dark"] QGroupBox,
[theme="dark"] QTabWidget::pane,
[theme="dark"] QToolBar,
[theme="dark"] QStatusBar,
[theme="dark"] QTreeView,
[theme="dark"] QListView,
[theme="dark"] QTableView,
[theme="dark"] QTextBrowser,
[theme="dark"] QLineEdit,
[theme="dark"] QTextEdit,
[theme="dark"] QPlainTextEdit,
[theme="dark"] QComboBox,
[theme="dark"] QSpinBox,
[theme="dark"] QPushButton,
[theme="dark"] QCheckBox,
[theme="dark"] QRadioButton,
[theme="dark"] QProgressBar,
[theme="dark"] QMessageBox {
    background-color: #1B1B1B;
    color: #FFFFFF;
    border-color: #3F3F46;
}

[theme="dark"] QWidget {
    font-family: "Segoe UI Variable", "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
    color: #FFFFFF;
    background-color: #1B1B1B;
}

[theme="dark"] MainWindow {
    background-color: #1B1B1B;
    border-radius: 8px;
}

[theme="dark"] QTabWidget::pane {
    border-color: #3F3F46;
    background-color: #1B1B1B;
}

[theme="dark"] QTabBar::tab {
    color: #CCCCCC;
}

[theme="dark"] QTabBar::tab:selected {
    background-color: #1B1B1B;
    border-bottom-color: #0078D4;
    color: #3A96DD;
}

[theme="dark"] QTabBar::tab:hover:!selected {
    background-color: #2D2D2D;
}

[theme="dark"] QTabBar::close-button:hover {
    background-color: #383838;
}

[theme="dark"] QMenuBar::item:selected {
    background-color: #2D2D2D;
    color: #FFFFFF;
}

[theme="dark"] QMenu {
    border-color: #3F3F46;
    background-color: #252526;
    color: #FFFFFF;
}

[theme="dark"] QMenu::item:selected {
    background-color: #2D2D2D;
    color: #FFFFFF;
}

[theme="dark"] QMenu::separator {
    background-color: #3F3F46;
}

[theme="dark"] QToolButton:hover {
    background-color: #2D2D2D;
}

[theme="dark"] QToolButton:pressed {
    background-color: #383838;
}

[theme="dark"] QToolButton:disabled {
    color: #808080;
}

[theme="dark"] QStatusBar {
    background-color: #252526;
    border-top-color: #3F3F46;
    color: #CCCCCC;
}

[theme="dark"] QDockWidget::title {
    border-bottom-color: #3F3F46;
    color: #CCCCCC;
}

[theme="dark"] QDockWidget::close-button:hover,
[theme="dark"] QDockWidget::float-button:hover {
    background-color: #383838;
}

[theme="dark"] QPushButton {
    border-color: #3F3F46;
    background-color: #252526;
    color: #FFFFFF;
}

[theme="dark"] QPushButton:hover {
    background-color: #2D2D2D;
    border-color: #616161;
}

[theme="dark"] QPushButton:pressed {
    background-color: #383838;
    border-color: #808080;
}

[theme="dark"] QPushButton:disabled {
    color: #808080;
    border-color: #383838;
    background-color: #2D2D2D;
}

[theme="dark"] QPushButton[primary="true"] {
    background-color: #0078D4;
    border-color: #0078D4;
    color: #FFFFFF;
}

[theme="dark"] QPushButton[primary="true"]:hover {
    background-color: #3A96DD;
    border-color: #3A96DD;
}

[theme="dark"] QPushButton[primary="true"]:pressed {
    background-color: #005A9E;
    border-color: #005A9E;
}

[theme="dark"] QComboBox {
    border-color: #3F3F46;
    background-color: #252526;
    color: #FFFFFF;
}

[theme="dark"] QComboBox:hover {
    border-color: #0078D4;
}

[theme="dark"] QComboBox:focus {
    border-color: #0078D4;
    border-width: 2px;
    padding: 5px 11px 5px 11px;
}

[theme="dark"] QComboBox:disabled {
    color: #808080;
    border-color: #383838;
    background-color: #2D2D2D;
}

[theme="dark"] QComboBox::drop-down {
    border-left-color: #3F3F46;
}

[theme="dark"] QComboBox::drop-down:hover {
    background-color: #2D2D2D;
}

[theme="dark"] QComboBox QAbstractItemView {
    border-color: #3F3F46;
    background-color: #252526;
    selection-background-color: #004578;
    selection-color: #FFFFFF;
}

[theme="dark"] QComboBox QAbstractItemView::item:selected {
    background-color: #004578;
    color: #FFFFFF;
}

[theme="dark"] QSpinBox {
    border-color: #3F3F46;
    background-color: #252526;
    color: #FFFFFF;
}

[theme="dark"] QSpinBox:hover {
    border-color: #0078D4;
}

[theme="dark"] QSpinBox:focus {
    border-color: #0078D4;
    border-width: 2px;
    padding: 5px 11px 5px 11px;
}

[theme="dark"] QSpinBox:disabled {
    color: #808080;
    border-color: #383838;
    background-color: #2D2D2D;
}

[theme="dark"] QSpinBox::up-button,
[theme="dark"] QSpinBox::down-button {
    background: transparent;
}

[theme="dark"] QSpinBox::up-button:hover,
[theme="dark"] QSpinBox::down-button:hover {
    background-color: #2D2D2D;
}

[theme="dark"] QLineEdit,
[theme="dark"] QTextEdit,
[theme="dark"] QPlainTextEdit {
    border-color: #3F3F46;
    background-color: #252526;
    color: #FFFFFF;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

[theme="dark"] QLineEdit:hover,
[theme="dark"] QTextEdit:hover,
[theme="dark"] QPlainTextEdit:hover {
    border-color: #616161;
}

[theme="dark"] QLineEdit:focus,
[theme="dark"] QTextEdit:focus,
[theme="dark"] QPlainTextEdit:focus {
    border-color: #0078D4;
    border-width: 2px;
    padding: 7px 11px;
}

[theme="dark"] QLineEdit:disabled,
[theme="dark"] QTextEdit:disabled,
[theme="dark"] QPlainTextEdit:disabled {
    color: #808080;
    border-color: #383838;
    background-color: #2D2D2D;
}

[theme="dark"] QLineEdit[readOnly="true"],
[theme="dark"] QTextEdit[readOnly="true"],
[theme="dark"] QPlainTextEdit[readOnly="true"] {
    background-color: #2D2D2D;
    color: #CCCCCC;
}

[theme="dark"] QCheckBox::indicator,
[theme="dark"] QRadioButton::indicator {
    border-color: #3F3F46;
    background-color: #252526;
}

[theme="dark"] QCheckBox::indicator:hover,
[theme="dark"] QRadioButton::indicator:hover {
    border-color: #0078D4;
}

[theme="dark"] QCheckBox::indicator:checked {
    background-color: #0078D4;
    border-color: #0078D4;
}

[theme="dark"] QCheckBox::indicator:unchecked:hover {
    background-color: #2D2D2D;
}

[theme="dark"] QRadioButton::indicator:checked {
    background-color: #252526;
    border-color: #0078D4;
}

[theme="dark"] QSlider::groove:horizontal {
    background-color: #3F3F46;
}

[theme="dark"] QSlider::handle:horizontal {
    background-color: #0078D4;
}

[theme="dark"] QSlider::handle:horizontal:hover {
    background-color: #3A96DD;
}

[theme="dark"] QSlider::handle:horizontal:pressed {
    background-color: #005A9E;
}

[theme="dark"] QSlider::sub-page:horizontal {
    background-color: #0078D4;
}

[theme="dark"] QScrollBar:vertical {
    background-color: transparent;
}

[theme="dark"] QScrollBar::handle:vertical {
    background-color: #4E4E4E;
}

[theme="dark"] QScrollBar::handle:vertical:hover {
    background-color: #6E6E6E;
}

[theme="dark"] QScrollBar::handle:vertical:pressed {
    background-color: #808080;
}

[theme="dark"] QScrollBar:horizontal {
    background-color: transparent;
}

[theme="dark"] QScrollBar::handle:horizontal {
    background-color: #4E4E4E;
}

[theme="dark"] QScrollBar::handle:horizontal:hover {
    background-color: #6E6E6E;
}

[theme="dark"] QScrollBar::handle:horizontal:pressed {
    background-color: #808080;
}

[theme="dark"] QTreeView,
[theme="dark"] QListView {
    border-color: #3F3F46;
    background-color: #1B1B1B;
    alternate-background-color: #252526;
}

[theme="dark"] QTreeView::item,
[theme="dark"] QListView::item {
    color: #FFFFFF;
}

[theme="dark"] QTreeView::item:selected,
[theme="dark"] QListView::item:selected {
    background-color: #004578;
    color: #3A96DD;
}

[theme="dark"] QTreeView::item:hover:!selected,
[theme="dark"] QListView::item:hover:!selected {
    background-color: #2D2D2D;
}

[theme="dark"] QHeaderView::section {
    border-bottom-color: #3F3F46;
    background-color: #252526;
    color: #CCCCCC;
}

[theme="dark"] QTableView {
    border-color: #3F3F46;
    background-color: #1B1B1B;
    gridline-color: #3F3F46;
    alternate-background-color: #252526;
}

[theme="dark"] QTableView::item:selected {
    background-color: #004578;
    color: #3A96DD;
}

[theme="dark"] QGroupBox {
    border-color: #3F3F46;
    background-color: #1B1B1B;
    color: #FFFFFF;
}

[theme="dark"] QGroupBox::title {
    background-color: #1B1B1B;
}

[theme="dark"] QLabel {
    color: #FFFFFF;
}

[theme="dark"] QLabel[secondary="true"] {
    color: #CCCCCC;
}

[theme="dark"] QProgressBar {
    border-color: #3F3F46;
    background-color: #2D2D2D;
    color: #FFFFFF;
}

[theme="dark"] QProgressBar::chunk {
    background-color: #0078D4;
}

[theme="dark"] QSplitter::handle {
    background-color: #3F3F46;
}

[theme="dark"] QSplitter::handle:hover {
    background-color: #0078D4;
}

[theme="dark"] QToolTip {
    border-color: #3F3F46;
    background-color: #FFFFFF;
    color: #1B1B1B;
}

[theme="dark"] QMessageBox {
    background-color: #252526;
}

[theme="dark"] QMessageBox QLabel {
    color: #FFFFFF;
}

[theme="dark"] QTextBrowser {
    border-color: #3F3F46;
    background-color: #1B1B1B;
    color: #FFFFFF;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

[theme="dark"] QTextBrowser a {
    color: #3A96DD;
}

[theme="dark"] QTextBrowser a:hover {
    color: #5BB5EE;
}

/* Focus for dark */
[theme="dark"] QWidget:focus {
    outline: none;
}

[theme="dark"] QLineEdit:focus,
[theme="dark"] QTextEdit:focus,
[theme="dark"] QPlainTextEdit:focus,
[theme="dark"] QComboBox:focus,
[theme="dark"] QSpinBox:focus,
[theme="dark"] QPushButton:focus,
[theme="dark"] QCheckBox:focus,
[theme="dark"] QRadioButton:focus,
[theme="dark"] QTabBar::tab:focus,
[theme="dark"] QTreeView:focus,
[theme="dark"] QListView:focus,
[theme="dark"] QTableView:focus {
    border: 2px solid #0078D4;
}

